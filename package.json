{
  "name": "yckuo",
  "description": "YuCheng Kuo's home page on the web.",
  "authors": "YuCheng Kuo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuchengkuo/yckuo"
  },
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/port-guard.mjs",
    "guard": "node scripts/port-guard.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "sync": "node scripts/sync-content.mjs",
    "sync:control": "node scripts/sync-content.mjs --control --report"
  },
  "dependencies": {
    "@astrojs/markdoc": "2.0.6",
    "@astrojs/svelte": "9.0.1",
    "@markdoc/markdoc": "0.5.9",
    "@shikijs/transformers": "^3.0.0",
    "@unocss/astro": "^66.6.8",
    "@vercel/analytics": "^1.6.1",
    "astro": "7.2.2",
    "cloudinary-build-url": "^0.2.4",
    "lenis": "^1.3.26",
    "shiki": "^3.0.0",
    "svelte": "^5.56.9",
    "unocss": "^66.6.8"
  },
  "devDependencies": {
    "@cld-apis/types": "^0.1.6",
    "@iconify-json/ri": "^1.2.10",
    "@radix-ui/colors": "^3.0.0",
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@markdoc/markdoc@0.5.9": "patches/@markdoc__markdoc@0.5.9.patch"
    }
