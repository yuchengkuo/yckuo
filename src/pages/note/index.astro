---
/* No og:title or og:description — there is no content entry behind this route. */
import Base from '../../layouts/Base.astro'
import NoteRow from '../../components/NoteRow.astro'
import { getNotes } from '../../lib/collections'

const notes = await getNotes()
---

<Base title="Notes — YuCheng Kuo">
  <div class="mt-8 mb-16">
    <h1 class="text-6 leading-8">Notes</h1>
  </div>

  {/* Without `grid-subgrid` the rows' column placements go inert. */}
  <ul class="grid-subgrid list-none p-0 m-0">
    {notes.map((note) => <NoteRow note={note} />)}
  </ul>
</Base>
