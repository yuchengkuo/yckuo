---
/*
 * THE LIST IS NOT SORTED — see the note over `getNotes()` in `lib/collections.ts`.
 *
 * THE HREFS MUST BE ABSOLUTE. Astro's directory build format writes `note/index.html`,
 * which a host may serve at `/note/`, and a relative `href="note/windicss"` resolves
 * from there to `/note/note/windicss`. One character, and the link surface of the
 * whole section.
 *
 * og:title and og:description are absent by design: this is the one route with no
 * content entry behind it, so there is nothing to put in them.
 */
import Base from '../../layouts/Base.astro'
import More from '../../components/More.astro'
import { getNotes } from '../../lib/collections'
import { formatDate } from '../../lib/util'

const notes = await getNotes()
---

<Base title="Notes — YuCheng Kuo">
  <More>
    <nav>
      <ul>
        {
          notes.map((note) => (
            <li>
              {/* `{' '}` is load-bearing. JSX drops the newline, and `<time>`'s own
                  `ml-2` is a margin on top of that space, not a replacement for it. */}
              <a href={`/${note.id}`}>{note.data.title}</a>{' '}
              <time datetime={note.data.updated.toISOString()}>{formatDate(note.data.updated)}</time>
            </li>
          ))
        }
      </ul>
    </nav>
  </More>
</Base>

<style>
  nav ul {
    --uno: 'list-none p-0 m-0';
  }

  nav li {
    --uno: 'mb-4';
  }

  nav a {
    --uno: 'text-primary';
  }

  time {
    --uno: 'font-mono text-xs text-tertiary ml-2';
  }
</style>
