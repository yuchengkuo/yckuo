---
/*
 * ONE ROUTE, TWO COLLECTIONS — because velite's slug is the path. `pages` is root-only
 * (`about`, `colophon`, `contact`, `now`, `shots`) and `projects` lives under
 * `project/`, and `s.path()` gave the latter the id `project/pages`, which the homepage
 * links bare. The SvelteKit catch-all served both off one `/api/content/entry/<slug>`
 * lookup for exactly that reason; `entry.id` is that slug, so a rest parameter
 * reproduces it with no per-collection rule.
 *
 * `index` IS EXCLUDED, and that is a ported behaviour rather than a tidy-up. SvelteKit's
 * catch-all would have served `/index` on request, but `prerender = true` builds only
 * what the crawler reaches and nothing links `/index`, so it has never been built or
 * served — `/index` 404s in production today. Leaving it in would
 * also emit `content/index.mdoc` twice, once here and once as the homepage.
 *
 * No wrapper element sits between `<main>` and this output: the `<div>` below is
 * the page's own first child, exactly as `+page.svelte` had it, and `<Content />` is a
 * direct sibling.
 */
import { render, type CollectionEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { getPages, getProjects } from '../lib/collections'
import { formatDate } from '../lib/util'

export async function getStaticPaths() {
  const [pages, projects] = await Promise.all([getPages(), getProjects()])

  return [...pages.filter((entry) => entry.id !== 'index'), ...projects].map((entry) => ({
    params: { page: entry.id },
    props: { entry }
  }))
}

interface Props {
  entry: CollectionEntry<'pages'> | CollectionEntry<'projects'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Base
  title={`${entry.data.title} — YuCheng Kuo`}
  ogTitle={entry.data.title}
  description={entry.data.description}
>
  <div class="mt-8 mb-16">
    <h1 class="text-8 leading-10 font-medium">{entry.data.title}</h1>
    <p class="text-secondary font-mono text-xs mt-1">{entry.data.subtitle}</p>
  </div>

  {/*
    THE SPREAD IS LOAD-BEARING. `@astrojs/markdoc` turns every prop on
    `<Content />` into a Markdoc VARIABLE (`runtime.js:163`, `mergeConfig(userConfig,
    { variables: props })`), which is how velite's
    `variables: { ...records, ...markdocConfig.variables }` ports. `content/now.mdoc`
    opens its body with `{% $description %}` — one file, one variable, and without this
    the paragraph renders empty with a green build and 7/7 assertions.
  */}
  <Content {...entry.data} />

  <p class="mt-20 text-tertiary font-mono text-xs">
    Updated at <time datetime={entry.data.updated.toISOString()}
      >{formatDate(entry.data.updated)}</time
    >
  </p>
</Base>
