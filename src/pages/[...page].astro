---
/*
 * ONE ROUTE, TWO COLLECTIONS — because `entry.id` carries the directory. `pages` is
 * root-only (`about`, `colophon`, `contact`, `now`, `shots`) and `projects` lives under
 * `project/`, so the latter's id is `project/pages`, which the homepage links bare. A
 * rest parameter serves both with no per-collection rule.
 *
 * `index` IS EXCLUDED. `/index` has never been built or served — it 404s in production
 * — and leaving it in would also emit `content/index.mdoc` twice, once here and once as
 * the homepage.
 *
 * No wrapper element sits between `<main>` and this output: the `<div>` below is the
 * page's own first child and `<Content />` is a direct sibling. A wrapper that is not
 * itself `grid-subgrid` severs the subgrid chain.
 */
import { render, type CollectionEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { getPages, getProjects } from '../lib/collections'
import { formatDate } from '../lib/util'

export async function getStaticPaths() {
  const [pages, projects] = await Promise.all([getPages(), getProjects()])

  return [...pages.filter((entry) => entry.id !== 'index'), ...projects].map((entry) => ({
    params: { page: entry.id },
    props: { entry }
  }))
}

interface Props {
  entry: CollectionEntry<'pages'> | CollectionEntry<'projects'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Base
  title={`${entry.data.title} — YuCheng Kuo`}
  ogTitle={entry.data.title}
  description={entry.data.description}
>
  <div class="mt-8 mb-16">
    <h1 class="text-8 leading-10 font-medium">{entry.data.title}</h1>
    <p class="text-secondary font-mono text-xs mt-1">{entry.data.subtitle}</p>
  </div>

  {
    /*
    THE SPREAD IS LOAD-BEARING. `@astrojs/markdoc` turns every prop on `<Content />`
    into a Markdoc VARIABLE, which is how frontmatter reaches the body.
    `content/now.mdoc` opens with `{% $description %}` — one file, one variable, and
    without this spread that paragraph renders empty with a green build.
  */
  }
  <Content {...entry.data} />

  <p class="mt-20 text-tertiary font-mono text-xs">
    Updated at <time datetime={entry.data.updated.toISOString()}
      >{formatDate(entry.data.updated)}</time
    >
  </p>
</Base>
