---
/*
 * It MUST emit its three elements with no wrapper. The snippet is called from two
 * different parents — a `grid-subgrid` card for featured projects and a plain
 * `md:span-4` block for the rest — and the `col-span-*` classes below are placed by
 * whichever grid the caller is, so a wrapper element here would sever the subgrid chain.
 * An `.astro` component renders as a fragment, so this holds by construction rather than
 * by care.
 *
 * `p.span-5` IS CLAMPED, knowingly. The non-featured caller wraps this in `md:span-4`,
 * and a subgrid cannot create implicit tracks — so a 5-column span inside a 4-column
 * parent clamps to 4 and the intended 5-of-8 measure is silently the block's full width.
 * Unfixed because fixing it changes a rendered width, which is a visual decision.
 */
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { title, category, summary, link } = project.data

/*
 * The Read button's hover state, mirrored off `.button-secondary:hover` in main.css
 * because that rule is dead here: the button sits under the title link's stretched
 * `::after`, which is positioned and swallows every pointer event aimed at it.
 *
 * Keyed on `.stretch-link:hover` and NOT on the row's `group:hover`. The overlay IS the
 * title link, so the title link is hovered exactly when the pointer is over the row and
 * NOT over the View button — View escapes the overlay via `relative` below, and a
 * `group-hover:` would fire there too, lighting a button the pointer is nowhere near.
 * The same signal already drives the title's own underline, so the two stay in step.
 *
 * Every class is spelled out whole because the extractor reads raw file text: a
 * template literal generates no CSS at all, with a green build and a class attribute
 * that still reads correctly in the DOM. Keep these three in sync with
 * `.button-secondary`'s `hover:()` — the secondary variant flips `text-on-color` too,
 * which the primary carries at rest.
 */
const readHover =
  '[.group:has(.stretch-link:hover)_&]:bg-button-secondary-hover [.group:has(.stretch-link:hover)_&]:text-on-color [.group:has(.stretch-link:hover)_&]:border-transparent'
---

<div class="grid-subgrid span-full mb-8 relative group">
  <div class="md:span-4">
    <h3 class="mb-1.5">
      {
        /*
        The stretched link: `::after` covers the row's padding box (not its `mb-8`, which
        is margin), so the whole row is the tap target while the DOM keeps ONE anchor to
        the project page. A wrapping `<a class="contents">` cannot do this — `<a>` may not
        contain `<a>`, and the parser's adoption agency algorithm answers one by closing
        the wrapper into an empty sibling and cloning it down the tree. The row still
        renders, the classes are all still correct, and the link is silently broken. Astro
        emits what you wrote; the browser is what rewrites it, so only the DOM shows the
        damage.
      */
      }
      <a class="stretch-link after:absolute after:inset-0 after:content-empty" href={project.id}
        >{title}</a
      ><span class="text-tertiary font-mono text-xs ml-1"> ({category[0]})</span>
    </h3>
    <p class="span-5 text-secondary font-mono text-xs mb-4">
      {summary}
    </p>
  </div>

  <div class="flex gap-2 children:inline-block start-5 span-2 w-fit h-fit justify-self-end">
    {
      /*
      `relative` is what keeps this anchor clickable. The title's stretched `::after` is
      positioned and therefore paints above every statically positioned sibling; giving
      this one a position of its own puts it back on top, since it comes later in the DOM
      and both have `z-index: auto`. Its own `:hover` then still matches, so the
      `.button-primary` hover rule in main.css needs no mirror. Remove `relative` and the
      external link becomes unreachable while the markup still reads correctly.
    */
      link && (
        <a href={link} class="button-primary relative">
          View ↗
        </a>
      )
    }

    {
      /*
    `aria-hidden` + `tabindex="-1"`, together and never one without the other: this
    duplicates the destination of the title link above it, so a screen reader's link list
    would name every project twice with nothing to tell the two apart. Hiding a focusable
    element from the a11y tree is a violation on its own; paired with removal from the tab
    order it is the standard treatment for a redundant affordance, and the title link still
    reaches the page for both keyboard and AT.

    Its own `:hover` is dead — unlike View above, this anchor sits under the title's
    stretched overlay and never receives a pointer event. `readHover` above is the
    mirror, and carries the reason it is keyed on the overlay rather than on the row.
  */
    }
    <a class={`button-secondary ${readHover}`} href={project.id} aria-hidden="true" tabindex="-1"
      >Read →</a
    >
  </div>
</div>
