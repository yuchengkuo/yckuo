---
/*
 * Deliberately NO `client:` directive. `Gallery.svelte` has no client behaviour — it is
 * a styled wrapper around its slot — so it server-renders through this wrapper with slot
 * children intact and zero hydration. A10 in `port-guard.mjs` asserts that no island
 * renders inside `<main>`.
 */
import Gallery from '../lib/content/Gallery.svelte'
---

<Gallery><slot /></Gallery>
