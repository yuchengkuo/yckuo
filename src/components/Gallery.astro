 * a styled wrapper around its slot — so it server-renders through this wrapper with slot
 * children intact and zero hydration.
 *
 * Gallery.svelte is the SvelteKit file, copied verbatim.
 */
import Gallery from '../lib/content/Gallery.svelte'
---

<Gallery><slot /></Gallery>
