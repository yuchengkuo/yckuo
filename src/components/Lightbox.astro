---
/*
 * See CONTEXT.md's *Lightbox*. A plain script, not an island: the openers are the static
 * media inside `<main>`, which A10 keeps island-free.
 */
interface Props {
  title?: string
}

const { title } = Astro.props
---

<dialog class="lightbox" aria-label="Media" data-lightbox>
  <div class="frame" data-dismiss>
    <div class="top" data-dismiss>
      <button type="button" class="link close" data-close>[x] close</button>
      <p class="text-secondary text-center">{title}</p>
    </div>

    <div class="stage">
      <div class="box" data-box>
        <div class="slot" data-slot></div>
      </div>
      {/* Over the whole stage, not the box: the frame's padding and gaps are what close. */}
      <button type="button" class="zone" tabindex="-1" aria-hidden="true" data-prev></button>
      <button type="button" class="zone" tabindex="-1" aria-hidden="true" data-next></button>
    </div>

    <div class="bar">
      <p>
        <span data-title></span>
        <span class="block text-tertiary" data-description></span>
      </p>
      <div class="nav" data-nav>
        <button type="button" class="link" data-prev>[←] prev</button>
        <span class="text-tertiary" aria-hidden="true">/</span>
        <button type="button" class="link" data-next>next [→]</button>
        <span class="text-tertiary" data-count></span>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { lenis } from '../lib/lenis'
  import { collectMedia, type LightboxItem } from '../lib/media/lightbox'

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')
  const items = collectMedia()

  if (dialog && items.length > 0) {
    const $ = <T extends HTMLElement>(selector: string) => dialog.querySelector<T>(selector)!
    const slot = $('[data-slot]')
    const box = $('[data-box]')
    const title = $('[data-title]')
    const description = $('[data-description]')
    const count = $('[data-count]')
    const prevs = dialog.querySelectorAll<HTMLButtonElement>('[data-prev]')
    const nexts = dialog.querySelectorAll<HTMLButtonElement>('[data-next]')

    $('[data-nav]').hidden = items.length < 2

    let index = 0
    const preloaded = new Set<number>()

    /* `100vw`, not the box width: the srcset tops out at 2100, and a smaller pick goes soft
       on a wide screen. */
    const media = (item: LightboxItem) => {
      if (item.kind === 'video') {
        const video = document.createElement('video')
        Object.assign(video, { autoplay: true, muted: true, loop: true, playsInline: true })
        if (item.poster) video.poster = item.poster
        if (item.alt) video.setAttribute('aria-label', item.alt)
        video.src = item.src
        return video
      }
      const img = new Image()
      img.alt = item.alt
      img.sizes = '100vw'
      if (item.srcset) img.srcset = item.srcset
      img.src = item.src
      return img
    }

    const preload = (i: number) => {
      const item = items[i]
      if (!item || item.kind !== 'image' || preloaded.has(i)) return
      preloaded.add(i)
      media(item)
    }

    const show = (i: number) => {
      index = i
      const item = items[i]
      box.style.setProperty('--w', String(item.width))
      box.style.setProperty('--h', String(item.height))
      slot.replaceChildren(media(item))
      title.textContent = item.title ?? ''
      description.textContent = item.description ?? ''
      description.hidden = !item.description
      count.textContent = `${i + 1}/${items.length}`
      for (const button of prevs) button.disabled = i === 0
      for (const button of nexts) button.disabled = i === items.length - 1
      preload(i - 1)
      preload(i + 1)
    }

    /* No wrap: the sequence is document order. */
    const step = (delta: number) => {
      const target = index + delta
      if (target >= 0 && target < items.length) show(target)
    }

    const open = (i: number) => {
      show(i)
      lenis.stop()
      dialog.showModal()
    }

    items.forEach(({ box: opener, alt }, i) => {
      /* Set at runtime, not rendered, so the built HTML that A12 counts is unchanged. */
      opener.tabIndex = 0
      opener.setAttribute('role', 'button')
      opener.setAttribute('aria-label', alt ? `View ${alt}` : 'View media')
      opener.dataset.lightboxOpener = ''
      opener.addEventListener('click', () => open(i))
      opener.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return
        event.preventDefault()
        open(i)
      })
    })

    $('[data-close]').addEventListener('click', () => dialog.close())
    for (const button of prevs) button.addEventListener('click', () => step(-1))
    for (const button of nexts) button.addEventListener('click', () => step(1))

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      if (target === dialog || target.hasAttribute('data-dismiss')) dialog.close()
    })

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') step(-1)
      else if (event.key === 'ArrowRight') step(1)
    })

    dialog.addEventListener('close', () => {
      slot.querySelector('video')?.pause()
      lenis.start()
    })

    let touchX = 0
    let touchY = 0
    const stage = $('.stage')
    stage.addEventListener(
      'touchstart',
      (event) => {
        touchX = event.touches[0].clientX
        touchY = event.touches[0].clientY
      },
      { passive: true }
    )
    stage.addEventListener(
      'touchend',
      (event) => {
        const dx = event.changedTouches[0].clientX - touchX
        const dy = event.changedTouches[0].clientY - touchY
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1)
      },
      { passive: true }
    )
  }
</script>

<style>
  .lightbox {
    --uno: 'fixed inset-0 m-0 p-0 border-0 w-full h-full max-w-none max-h-none';
    --uno: 'text-primary text-xs font-mono backdrop-blur-xs';
    --lightbox-color: var(--colors-radix-sage-1);
    background: color-mix(in srgb, var(--lightbox-color) 90%, transparent);

    @media (prefers-color-scheme: dark) {
      --lightbox-color: var(--colors-radix-dark-sage-1);
    }
  }
  .lightbox::backdrop {
    background: transparent;
  }

  .frame {
    --uno: 'h-full max-w-400 mx-auto flex flex-col gap-8 p-8';
  }

  /* `1fr auto 1fr`, so the title centres on the frame, not on what the close button leaves. */
  .top {
    --uno: 'grid grid-cols-[1fr_auto_1fr] gap-x-4 items-baseline';
  }

  .stage {
    --uno: 'relative flex-1 min-h-0 grid place-items-center';
    container-type: size;
  }

  /* Contain-fit from the manifest ratio, so the box is sized before the media loads. */
  .box {
    --uno: 'relative rounded-0.5 bg-surface border border-neutral overflow-hidden';
    width: min(100cqw, 1200px, min(100cqh, 72vh) * var(--w) / var(--h));
    aspect-ratio: var(--w) / var(--h);
  }
  .slot {
    --uno: 'w-full h-full';
  }
  .slot > :global(img),
  .slot > :global(video) {
    --uno: 'block w-full h-full object-cover';
  }

  /* The built-in single-direction arrows; CSS has no next/previous cursor. */
  .zone {
    --uno: 'absolute inset-y-0 w-1/2 border-0 p-0 bg-transparent';
  }
  .zone[data-prev] {
    --uno: 'left-0';
    cursor: w-resize;
  }
  .zone[data-next] {
    --uno: 'right-0';
    cursor: e-resize;
  }
  .zone:disabled {
    cursor: default;
  }

  /* The nav column is always two lines, so a caption without a description sits on the
     counter's line and the bar's height holds — otherwise the stage resizes and the controls
     jump. */
  .bar {
    --uno: 'grid grid-cols-[1fr_auto] gap-x-4 items-end';
  }
  .nav {
    --uno: 'grid grid-cols-[auto_auto_auto] gap-x-2 justify-items-end';
  }
  .nav > [data-count] {
    --uno: 'col-span-3';
  }

  /* Undoes main.css's global `button` chrome, to match the header's link. */
  .link {
    --uno: 'border-0 p-0 bg-transparent normal-case w-fit';
    --uno: 'text-secondary hover:text-primary disabled:(text-tertiary cursor-default)';
  }
  .close {
    --uno: 'text-tertiary';
  }

  :global([data-lightbox-opener]) {
    cursor: zoom-in;
  }
  /* Inset: `Image.svelte`'s figure clips overflow, so an outset ring would be cut off. */
  :global([data-lightbox-opener]:focus-visible) {
    outline: 2px solid var(--lightbox-ring);
    outline-offset: -2px;
  }
  :global(:root) {
    --lightbox-ring: var(--colors-radix-sage-12);

    @media (prefers-color-scheme: dark) {
      --lightbox-ring: var(--colors-radix-dark-sage-12);
    }
  }
</style>
