---
/*
 * `src/routes/work/[page]/+page.svelte`, its loader and `work/+layout.svelte`, ported.
 *
 * THE PRERENDERED SET IS FOUR PAGES, NOT TEN — and that is a ported behaviour, not a
 * shortcut. SvelteKit's `work/+layout.server.ts` says `prerender = true`, which prerenders
 * the routes the crawler can REACH; the homepage links featured work only (04), so the
 * six additional works have never been built or served. `getStaticPaths()` has no crawler,
 * so the reachability has to be stated: it is the `featured` filter below. 16's page-set
 * comparison expects four.
 *
 * The next-project wraparound needs the whole featured collection, which `getStaticPaths()`
 * already holds — so `next` is resolved once here and handed to each page as a prop,
 * rather than each page re-reading the collection to find its own successor.
 *
 * `<Content />` and every element around it are direct children of `<Base>`'s slot: no
 * wrapper may sit between `<main>` and page output (07-4). `main > article` gives the
 * body its own subgrid, which is why `<Content />` is not wrapped in a `.prose` div the
 * way the homepage's intro is.
 *
 * `<meta property="og:type" content="article" />` from `work/+layout.svelte` arrives with
 * ticket 15, as the `ogType` prop below. SvelteKit emitted it *in addition to* the root
 * layout's `og:type="website"`, so every work page carried two — here the prop replaces
 * the default and the page carries one. Same for the duplicated `description`.
 */
import { render, type CollectionEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getWorks } from '../../lib/collections'
import { formatDate } from '../../lib/util'

export async function getStaticPaths() {
  const featured = (await getWorks()).filter((work) => work.data.featured)

  return featured.map((entry, index) => ({
    /* velite's `slug` is `entry.id` (13-3), so the id is `work/<slug>` and the route
       parameter is its tail. */
    params: { slug: entry.id.replace(/^work\//, '') },
    props: {
      entry,
      /* `+page.svelte`'s `nextProject`: the next featured work, wrapping at the end. */
      next: featured[index + 1 === featured.length ? 0 : index + 1]
    }
  }))
}

interface Props {
  entry: CollectionEntry<'works'>
  next: CollectionEntry<'works'>
}

const { entry, next } = Astro.props
const { Content } = await render(entry)

const metaEntries = Object.entries(entry.data.meta ?? {})
const summaryEntries = entry.data.summary ?? []
---

<Base
  title={`${entry.data.title} — YuCheng Kuo`}
  ogTitle={entry.data.title}
  ogType="article"
  description={entry.data.description}
>
  {/* Heading */}
  <div class="md:grid-subgrid layout-content">
    <h1 class="text-8 leading-10 lt-md:text-7 lt-md:leading-8 font-medium span-full">
      {entry.data.title}
    </h1>
    <p class="span-5 mb-30 mt-2 lt-md:mt-1 font-mono text-secondary text-xs leading-5">
      {entry.data.tagline}
    </p>
  </div>

  {/* Summary */}
  <dl class="layout-content grid-subgrid mb-16 font-mono text-xs prose">
    <dt class="text-secondary">Key Impact</dt>

    <dd class="span-full">
      <ul>
        {summaryEntries.map((summary) => <li>{summary}</li>)}
      </ul>
    </dd>
  </dl>

  {/* Metadata */}
  <section class="grid-subgrid layout-full mb-24 prose">
    {
      metaEntries.length > 0 && (
        <dl aria-label="Project metadata">
          {metaEntries.map(([key, value]) => {
            /* A meta value is a string or a list of strings; a string that looks like a
               URL becomes a link labelled with its bare host and path. */
            const label = typeof value === 'string' ? value.replace(/^(https?):\/\//, '') : ''
            return (
              <Fragment>
                <dt>{key}</dt>
                {typeof value !== 'string' ? (
                  value.map((v) => <dd>{v}</dd>)
                ) : (
                  <dd>
                    {value.startsWith('http') ? (
                      <a href={value} aria-label={`key link: ${label}`}>
                        {label}
                      </a>
                    ) : (
                      value
                    )}
                  </dd>
                )}
              </Fragment>
            )
          })}
        </dl>
      )
    }
  </section>

  {/* Content — frontmatter as Markdoc variables, see 15-1 in `[...page].astro` */}
  <Content {...entry.data} />
  <p class="mt-6 text-tertiary font-mono text-xs">
    Updated at <time datetime={entry.data.updated.toISOString()}
      >{formatDate(entry.data.updated)}</time
    >
  </p>

  {/* Next — bleeds past the content column to the right edge on desktop */}
  <section class="mt-32 layout-content md:end--1">
    <a href={`/${next.id}`} class="button-primary inline-block mb-4">Next →</a>
    <p class="text-8 leading-10 lt-md:text-7 lt-md:leading-8 font-medium span-full">
      {next.data.title}
    </p>
  </section>
</Base>
