---
/*
 * `src/routes/(more)/note/+page.svelte` and its loader, ported.
 *
 * THE LIST IS NOT SORTED, despite the loader fetching `.../collection/notes/desc`. The
 * endpoint parses its sort parameter as `key:direction`, so a bare `desc` fails both
 * halves of its guard and the sort never runs — see the note over `getNotes()` in
 * `lib/collections.ts`, and today's prerendered `/note`, whose six links are in
 * alphabetical filename order rather than any date order. Ported as it behaves.
 *
 * The hrefs are ABSOLUTE where SvelteKit's were relative (`href="note/windicss"`).
 * SvelteKit prerendered this page to `note.html`, served at `/note`, where a relative
 * href resolves correctly; Astro's default directory build format writes
 * `note/index.html`, which a host may serve at `/note/` — and from there the same
 * relative href resolves to `/note/note/windicss`. One character, and the link surface
 * of the section. (Finding 15-3.)
 *
 * og:title and og:description are absent on this page, matching the prerender: it is the
 * one route with no content entry behind it, so SvelteKit's `page.data.title` was
 * undefined and the attributes were omitted. Passing nothing reproduces that exactly.
 */
import Base from '../../layouts/Base.astro'
import More from '../../components/More.astro'
import { getNotes } from '../../lib/collections'
import { formatDate } from '../../lib/util'

const notes = await getNotes()
---

<Base title="Notes — YuCheng Kuo">
  <More>
    <nav>
      <ul>
        {
          notes.map((note) => (
            <li>
              {/* `{' '}` is load-bearing — see index.astro (18-2). JSX whitespace rules
                  drop this newline; `+page.svelte` keeps it as a space before `<time>`,
                  whose own `ml-2` is a margin on top of it, not a replacement for it. */}
              <a href={`/${note.id}`}>{note.data.title}</a>{' '}
              <time datetime={note.data.updated.toISOString()}>{formatDate(note.data.updated)}</time>
            </li>
          ))
        }
      </ul>
    </nav>
  </More>
</Base>

<style>
  /* `+page.svelte`'s scoped block, unchanged. */
  nav ul {
    --uno: 'list-none p-0 m-0';
  }

  nav li {
    --uno: 'mb-4';
  }

  nav a {
    --uno: 'text-primary';
  }

  time {
    --uno: 'font-mono text-xs text-tertiary ml-2';
  }
</style>
