---
/*
 * TEMPORARY — ticket 13's harness, deleted by tickets 14 and 15.
 *
 * The layer's exit condition is that all 26 content files render in `astro build`, and
 * a content layer with no route renders nothing. This is the smallest thing that
 * exercises every file: one page per entry, the body and nothing else.
 *
 * It is NOT the shape of the real routes. 14 ships `index.astro` and `work/[slug].astro`
 * with their headings, `<dl>`s and next-project wraparound; 15 ships `[...page].astro`,
 * the note section and `404.astro`. Both take precedence over this catch-all for their
 * own URLs while it exists, and both delete the part of it they replace — 15 removes the
 * file, since its `[...page].astro` is this route's successor.
 *
 * 14 HAS DELETED ITS PART: `works` is gone from the list below. It was not optional
 * housekeeping — this route builds a page per entry, so leaving `works` in would have
 * emitted all TEN work pages beside `work/[slug].astro`'s four, against a prerendered set
 * that is four today. `pages` still carries `index`, which this route builds at `/index/`
 * and the real homepage serves at `/`; that duplicate is 15's to remove with the file.
 *
 * `entry.id` is velite's `slug`, so `/${id}` is the URL for all four collections and the
 * path this route builds is the path the real routes will build.
 *
 * `<Content />` is the direct child of `<main>`'s slot with NO wrapper element, because
 * `main > :not(article)` is what places every grid annotation and one intervening `<div>`
 * makes all 68 inert with a green build (07-4, asserted as A4 by parity.mjs in 16).
 */
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'

export async function getStaticPaths() {
  const collections = await Promise.all(
    (['pages', 'projects', 'notes'] as const).map((name) => getCollection(name))
  )
  return collections.flat().map((entry) => ({ params: { entry: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Base title={entry.data.title} description={entry.data.description}>
  <Content />
</Base>
