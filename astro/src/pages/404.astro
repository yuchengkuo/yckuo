---
/*
 * `src/routes/+error.svelte`, ported. Its four lines of markup are verbatim; everything
 * else here is the head, which SvelteKit's error page never set — `+error.svelte` has no
 * `<svelte:head>`, so a 404 inherited whatever title the last route had rendered. Astro
 * builds this page standalone, so the title has to be stated; `404 — YuCheng Kuo` follows
 * the suffix every other route uses. og:title is left absent, matching the note index:
 * there is no content entry behind this page either.
 */
import Base from '../layouts/Base.astro'
---

<Base title="404 — YuCheng Kuo">
  <div class="mt-8 mb-16">
    <h1 class="text-8 leading-10 font-medium">404</h1>
    <p class="text-secondary font-mono text-xs mt-1">Page doesn't exist or removed.</p>
  </div>
</Base>
