---
/*
 * `CodeBlock.svelte` was one line — `{@html code}` — so the port drops the island
 * entirely rather than wrapping it. `code` is Shiki-highlighted HTML, produced
 * synchronously at transform time (see src/lib/highlighter.ts).
 */
const { code } = Astro.props
---

<Fragment set:html={code} />
